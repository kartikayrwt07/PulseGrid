# PulseGrid Environment Configuration
# Copy this file to .env and replace placeholders before running.

DATABASE_URL=sqlite:///./pulsegrid.db
SECRET_KEY=replace-with-random-64-char-hex-secret
DEMO_MODE=true
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
CURRENT_WEEK=9
TOTAL_WEEKS=14
ATTENDANCE_THRESHOLD=0.75
INTERNAL_THRESHOLD=0.40
THEORY_SESSIONS_PER_WEEK=3
LAB_SESSIONS_PER_WEEK=2
LOG_LEVEL=INFO
